# Copy this to .env for local testing (never commit .env)
# In GitHub: add these under Settings -> Secrets -> Actions

# Your GitHub personal access token (needs repo:read scope only)
# Generate at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scope: public_repo
# Starts with: ghp_ or github_pat_
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Your Groq API key
# Get one at: https://console.groq.com/keys
# Starts with: gsk_
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
